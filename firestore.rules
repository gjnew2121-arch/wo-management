rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────────────────
    function isAuth()    { return request.auth != null; }
    function isAdmin()   { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isEditor()  { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor'; }
    function isAdminOrEditor() { return isAdmin() || isEditor(); }

    function userCompany() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.company;
    }
    function canAccessGainjet() {
      return isAdmin() || userCompany() == 'GAINJET' || userCompany() == 'both';
    }
    function canAccessGjet() {
      return isAdmin() || userCompany() == 'GJET' || userCompany() == 'both';
    }

    // ── GAINJET WORK ORDERS ───────────────────────────────────────────────────
    match /gainjet_workOrders/{id} {
      allow read:   if isAuth() && canAccessGainjet();
      allow create: if isAuth() && canAccessGainjet() && isAdminOrEditor();
      allow update: if isAuth() && canAccessGainjet() && isAdminOrEditor();
      allow delete: if isAuth() && canAccessGainjet() && isAdminOrEditor();
    }

    // ── GAINJET DELETED (archive) ─────────────────────────────────────────────
    match /gainjet_deletedWOs/{id} {
      allow read:   if isAuth() && isAdmin();
      allow create: if isAuth() && canAccessGainjet() && isAdminOrEditor();
      allow delete: if isAuth() && isAdmin();
    }

    // ── GJET WORK ORDERS ──────────────────────────────────────────────────────
    match /gjet_workOrders/{id} {
      allow read:   if isAuth() && canAccessGjet();
      allow create: if isAuth() && canAccessGjet() && isAdminOrEditor();
      allow update: if isAuth() && canAccessGjet() && isAdminOrEditor();
      allow delete: if isAuth() && canAccessGjet() && isAdminOrEditor();
    }

    // ── GJET DELETED (archive) ────────────────────────────────────────────────
    match /gjet_deletedWOs/{id} {
      allow read:   if isAuth() && isAdmin();
      allow create: if isAuth() && canAccessGjet() && isAdminOrEditor();
      allow delete: if isAuth() && isAdmin();
    }

    // ── USERS ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
